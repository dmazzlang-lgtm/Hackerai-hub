-- ========== ESP ==========
local function newBox(player)
    local box = Drawing.new("Square")
    box.Thickness = 1
    box.Color = Color3.new(0, 1, 0)
    box.Transparency = 0.5
    box.Filled = false
    local name = Drawing.new("Text")
    name.Size = 14
    name.Center = true
    name.Outlined = true
    name.Color = Color3.new(1,1,1)
    local dist = Drawing.new("Text")
    dist.Size = 12
    dist.Center = true
    dist.Outlined = true
    dist.Color = Color3.new(1,1,0)
    return {box=box, name=name, dist=dist, player=player}
end

local function updateESP()
    for _, v in pairs(espTable) do
        v.box.Visible = false
        v.name.Visible = false
        v.dist.Visible = false
    end
    espTable = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if not root then continue end
            local head = char:FindFirstChild("Head")
            if not head then continue end

            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            if not onScreen then continue end

            local esp = newBox(player)
            local headPos, _ = Camera:WorldToScreenPoint(head.Position)
            local rootPos, _ = Camera:WorldToScreenPoint(root.Position)
            local height = math.abs(headPos.Y - rootPos.Y) * 2.5
            local width = height * 0.6
            local centerX = screenPos.X
            local centerY = (headPos.Y + rootPos.Y) / 2

            esp.box.Size = Vector2.new(width, height)
            esp.box.Position = Vector2.new(centerX - width/2, centerY - height/2)
            esp.box.Visible = true

            local dist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            esp.name.Text = player.Name
            esp.name.Position = Vector2.new(centerX, centerY - height/2 - 18)
            esp.name.Visible = true
            esp.dist.Text = string.format("%.1f m", dist/3.28)
            esp.dist.Position = Vector2.new(centerX, centerY + height/2 + 12)
            esp.dist.Visible = true

            table.insert(espTable, esp)
        end
    end
end

-- ========== SPIRAL ==========
local function drawSpiral(targetPart)
    for _, line in pairs(spiralLines) do line:Remove() end
    spiralLines = {}
    if not targetPart then return end
    local center = targetPart.Position
    for i = 1, 36 do
        local angle = i * 0.2
        local radius = 4 + i * 0.15
        local x = center.X + math.cos(angle) * radius
        local z = center.Z + math.sin(angle) * radius
        local point = Vector3.new(x, center.Y + math.sin(angle*2)*0.5, z)
        local screenPos, on = Camera:WorldToScreenPoint(point)
        if on then
            local line = Drawing.new("Line")
            line.Thickness = 2
            line.Color = Color3.fromRGB(255, 0, 255)
            line.Transparency = 0.8
            line.From = Vector2.new(screenPos.X, screenPos.Y)
            line.To = Vector2.new(screenPos.X + 2, screenPos.Y + 2)
            line.Visible = true
            table.insert(spiralLines, line)
        end
    end
end

-- ========== AIMBOT ==========
local function getClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local closest = nil
    local minDist = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local screenPos, on = Camera:WorldToScreenPoint(root.Position)
                if on then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function aimbotLoop()
    while task.wait(0.03) do
        if not aimbotEnabled then
            for _, l in pairs(spiralLines) do l:Remove() end
            spiralLines = {}
            continue
        end
        target = getClosestTarget()
        if target then
            local part = target.Character:FindFirstChild(aimMode == "HEAD" and "Head" or "HumanoidRootPart")
            if part then
                local pos, on = Camera:WorldToScreenPoint(part.Position)
                if on then
                    mousemoverel(pos.X - Mouse.X, pos.Y - Mouse.Y)
                end
                drawSpiral(part)
            else
                for _, l in pairs(spiralLines) do l:Remove() end
                spiralLines = {}
            end
        else
            for _, l in pairs(spiralLines) do l:Remove() end
            spiralLines = {}
        end
    end
end

-- ========== FARM & TELEPORT ==========
local function teleportToPart(partName)
    local part = workspace:FindFirstChild(partName, true)
    if not part then
        warn("[HACKERAI] Part not found: " .. partName)
        return false
    end
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    hrp.CFrame = part.CFrame + Vector3.new(0, config.teleportHeightOffset, 0)
    task.wait(0.5)
    return true
end

local function interactWithPart(part)
    local click = part:FindFirstChildOfClass("ClickDetector")
    if click then
        click:Click()
        task.wait(0.3)
        return true
    end
    local prompt = part:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
        task.wait(0.3)
        return true
    end
    local remote = ReplicatedStorage:FindFirstChild("Interact") or ReplicatedStorage:FindFirstChild("Buy")
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer(part)
        task.wait(0.3)
        return true
    end
    return false
end

local function resetCharacter()
    local char = LocalPlayer.Character
    if char then
        char:BreakJoints()
        task.wait(1.5)
    end
end

local function farmCycle()
    -- 1. Beli blank card di toko
    if teleportToPart(config.shopPartName) then
        local shopParts = workspace:GetDescendants()
        local shopPart = nil
        for _, obj in pairs(shopParts) do
            if obj:IsA("BasePart") and obj.Name:lower():find("shop") then
                shopPart = obj
                break
            end
        end
        if shopPart then
            interactWithPart(shopPart)
            print("[HACKERAI] Bought blank card")
        end
    end

    task.wait(1)

    -- 2. Aktivasi dan jual di ATM
    if teleportToPart(config.atmPartName) then
        local atmParts = workspace:GetDescendants()
        local atmPart = nil
        for _, obj in pairs(atmParts) do
            if obj:IsA("BasePart") and (obj.Name:lower():find("atm") or obj.Name:lower():find("bank")) then
                atmPart = obj
                break
            end
        end
        if atmPart then
            interactWithPart(atmPart)   -- aktivasi
            task.wait(0.5)
            interactWithPart(atmPart)   -- jual
            print("[HACKERAI] Activated and sold card")
        end
    end

    -- 3. Work (opsional)
    if teleportToPart(config.workPartName) then
        local workParts = workspace:GetDescendants()
        local workPart = nil
        for _, obj in pairs(workParts) do
            if obj:IsA("BasePart") and obj.Name:lower():find("work") then
                workPart = obj
                break
            end
        end
        if workPart then
            interactWithPart(workPart)
            print("[HACKERAI] Work done")
        end
    end

    -- 4. Reset karakter jika autoReset aktif
    if autoReset then
        resetCharacter()
        print("[HACKERAI] Character reset, camera normal")
    end
end

local function startFarmLoop()
    if farmTask then task.cancel(farmTask) end
    farmTask = task.spawn(function()
        while farmEnabled do
            local success, err = pcall(farmCycle)
            if not success then
                warn("[HACKERAI] Farm error: " .. tostring(err))
            end
            task.wait(config.farmInterval)
        end
    end)
end

