-- ========== ESP ==========
local function newBox(player)
    local box = Drawing.new("Square")
    box.Thickness = 1
    box.Color = Color3.new(0, 1, 0)
    box.Transparency = 0.5
    box.Filled = false
    local name = Drawing.new("Text")
    name.Size = 14
    name.Center = true
    name.Outlined = true
    name.Color = Color3.new(1,1,1)
    local dist = Drawing.new("Text")
    dist.Size = 12
    dist.Center = true
    dist.Outlined = true
    dist.Color = Color3.new(1,1,0)
    return {box=box, name=name, dist=dist, player=player}
end

local function updateESP()
    for _, v in pairs(espTable) do
        v.box.Visible = false
        v.name.Visible = false
        v.dist.Visible = false
    end
    espTable = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if not root then continue end
            local head = char:FindFirstChild("Head")
            if not head then continue end

            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            if not onScreen then continue end

            local esp = newBox(player)
            local headPos, _ = Camera:WorldToScreenPoint(head.Position)
            local rootPos, _ = Camera:WorldToScreenPoint(root.Position)
            local height = math.abs(headPos.Y - rootPos.Y) * 2.5
            local width = height * 0.6
            local centerX = screenPos.X
            local centerY = (headPos.Y + rootPos.Y) / 2

            esp.box.Size = Vector2.new(width, height)
            esp.box.Position = Vector2.new(centerX - width/2, centerY - height/2)
            esp.box.Visible = true

            local dist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            esp.name.Text = player.Name
            esp.name.Position = Vector2.new(centerX, centerY - height/2 - 18)
            esp.name.Visible = true
            esp.dist.Text = string.format("%.1f m", dist/3.28)
            esp.dist.Position = Vector2.new(centerX, centerY + height/2 + 12)
            esp.dist.Visible = true

            table.insert(espTable, esp)
        end
    end
end

-- ========== SPIRAL ==========
local function drawSpiral(targetPart)
    for _, line in pairs(spiralLines) do line:Remove() end
    spiralLines = {}
    if not targetPart then return end
    local center = targetPart.Position
    for i = 1, 36 do
        local angle = i * 0.2
        local radius = 4 + i * 0.15
        local x = center.X + math.cos(angle) * radius
        local z = center.Z + math.sin(angle) * radius
        local point = Vector3.new(x, center.Y + math.sin(angle*2)*0.5, z)
        local screenPos, on = Camera:WorldToScreenPoint(point)
        if on then
            local line = Drawing.new("Line")
            line.Thickness = 2
            line.Color = Color3.fromRGB(255, 0, 255)
            line.Transparency = 0.8
            line.From = Vector2.new(screenPos.X, screenPos.Y)
            line.To = Vector2.new(screenPos.X + 2, screenPos.Y + 2)
            line.Visible = true
            table.insert(spiralLines, line)
        end
    end
end

-- ========== AIMBOT (hanya aktif saat aimlockActive = true) ==========
local function getClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local fov = (aimMode == "HEAD") and config.fovHead or config.fovBody
    local closest = nil
    local minDist = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local screenPos, on = Camera:WorldToScreenPoint(root.Position)
                if on then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < minDist and dist < fov then
                        minDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function aimbotLoop()
    while task.wait(0.016) do
        if not aimbotEnabled then
            for _, l in pairs(spiralLines) do l:Remove() end spiralLines = {}
            continue
        end

        -- HP mode: hanya aktif jika aimlockActive = true
        local active = aimlockActive

        if active then
            target = getClosestTarget()
        else
            target = nil
            for _, l in pairs(spiralLines) do l:Remove() end spiralLines = {}
        end

        if target and active then
            local part = target.Character:FindFirstChild(aimMode == "HEAD" and "Head" or "HumanoidRootPart")
            if part then
                local pos, on = Camera:WorldToScreenPoint(part.Position)
                if on then
                    local targetX = pos.X
                    local targetY = pos.Y
                    local currentX = Mouse.X
                    local currentY = Mouse.Y
                    local deltaX = (targetX - currentX) * (1 - config.smoothAim)
                    local deltaY = (targetY - currentY) * (1 - config.smoothAim)
                    mousemoverel(deltaX, deltaY)
                end
                drawSpiral(part)
            else
                for _, l in pairs(spiralLines) do l:Remove() end spiralLines = {}
            end
        else
            for _, l in pairs(spiralLines) do l:Remove() end spiralLines = {}
        end
    end
end

-- ========== FARM ==========
local function findPartByKeywords(keywords, searchIn)
    searchIn = searchIn or workspace
    for _, obj in pairs(searchIn:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            for _, kw in ipairs(keywords) do
                if name:find(kw:lower()) then
                    return obj
                end
            end
        end
    end
    return nil
end

local function findRemoteEvent(keywords)
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = obj.Name:lower()
            for _, kw in ipairs(keywords) do
                if name:find(kw:lower()) then
                    return obj
                end
            end
        end
    end
    return nil
end

local function interactWithPart(part)
    local click = part:FindFirstChildOfClass("ClickDetector")
    if click then click:Click() task.wait(0.4) print("[HACKERAI] ClickDetector fired") return true end
    local prompt = part:FindFirstChildOfClass("ProximityPrompt")
    if prompt then prompt:InputHoldBegin() task.wait(0.15) prompt:InputHoldEnd() task.wait(0.4) print("[HACKERAI] ProximityPrompt fired") return true end
    local remote = findRemoteEvent({"Buy", "Sell", "Activate", "Interact", "Use"})
    if remote then remote:FireServer(part) task.wait(0.4) print("[HACKERAI] RemoteEvent fired: " .. remote.Name) return true end
    return false
end

local function teleportToPart(part)
    if not part then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    hrp.CFrame = part.CFrame + Vector3.new(0, config.teleportHeight, 0)
    task.wait(0.6)
    return true
end

local function farmCycle()
    print("[HACKERAI] Farm cycle started...")
    local shopPart = findPartByKeywords(config.shopKeywords)
    if shopPart then print("[HACKERAI] Shop found: " .. shopPart.Name) if teleportToPart(shopPart) then interactWithPart(shopPart) end else print("[HACKERAI] Shop not found!") end
    task.wait(1)
    local atmPart = findPartByKeywords(config.atmKeywords)
    if atmPart then print("[HACKERAI] ATM found: " .. atmPart.Name) if teleportToPart(atmPart) then interactWithPart(atmPart) task.wait(0.8) interactWithPart(atmPart) end else print("[HACKERAI] ATM not found!") end
