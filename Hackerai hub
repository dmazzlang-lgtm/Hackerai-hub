    if workPart then print("[HACKERAI] Work found: " .. workPart.Name) if teleportToPart(workPart) then interactWithPart(workPart) end else print("[HACKERAI] Work not found!") end
    print("[HACKERAI] Farm cycle complete.")
end

local function startFarmLoop()
    if farmTask then task.cancel(farmTask) end
    farmTask = task.spawn(function()
        while farmEnabled do
            local success, err = pcall(farmCycle)
            if not success then warn("[HACKERAI] Farm error: " .. tostring(err)) end
            task.wait(config.farmInterval)
        end
    end)
end

